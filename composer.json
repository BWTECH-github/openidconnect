{
    "name": "bwtech/openidconnect",
    "type": "library",
    "description": "OpenId Connect app for ownCloud. Modified by BW-Tech GmbH for owncloud.online (PHP 8.4 fork of owncloud/openidconnect).",
    "require": {
        "php": ">=8.4",
        "cweagans/composer-patches": "^1.7.3 || ^2.0.0",
        "jumbojett/openid-connect-php": "^1.0.2",
        "phpseclib/phpseclib": "^3.0.36"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.8",
        "roave/security-advisories": "dev-latest"
    },
    "extra": {
        "patches": {
            "jumbojett/openid-connect-php": {
                "Declare nullable parameters explicitly for PHP 8.4": "patches/jumbojett-openid-connect-php-php84-nullable.patch"
            }
        },
        "bamarni-bin": {
            "bin-links": false
        }
    },
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "Thomas Müller",
            "email": "thomas.mueller@tmit.eu"
        }
    ],
    "config" : {
        "optimize-autoloader": true,
        "classmap-authoritative": false,
        "platform": {
            "php": "8.4"
        },
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "cweagans/composer-patches": true
        }
    }
}
